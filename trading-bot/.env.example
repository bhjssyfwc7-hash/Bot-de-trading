# Copy this file to .env and fill in your Binance API credentials
# Never commit your real .env file to version control

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading mode: "paper" (simulated) or "live" (real money — use with caution)
TRADING_MODE=paper

# Trading pair and timeframe
SYMBOL=BTC/USDT
TIMEFRAME=1h

# RSI parameters
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Risk management
RISK_PER_TRADE=0.02        # 2% of portfolio per trade
STOP_LOSS_PCT=0.02         # 2% stop-loss
TAKE_PROFIT_PCT=0.04       # 4% take-profit
INITIAL_BALANCE=1000.0     # Paper trading starting balance (USDT)
