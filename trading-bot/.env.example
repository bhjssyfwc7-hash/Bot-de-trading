# Copy this file to .env and fill in your keys (not needed for paper trading)
# Never commit your real .env file to version control

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading mode: "paper" (simulated) or "live" (real money — disabled)
TRADING_MODE=paper

# ── Market ────────────────────────────────────────────────────────────────────
SYMBOL=BTC/USDT
TIMEFRAME=1m          # 1m | 3m | 5m | 15m | 1h

# ── Scalping indicators ───────────────────────────────────────────────────────
RSI_PERIOD=7
RSI_OVERSOLD=35
RSI_OVERBOUGHT=65
EMA_FAST=9
EMA_SLOW=21

# ── Risk management ───────────────────────────────────────────────────────────
STOP_LOSS_PCT=0.005       # -0.5%
TAKE_PROFIT_PCT=0.010     # +1.0%  (ratio 2:1)
CAPITAL_PER_TRADE=0.05    # 5% of portfolio per trade
MAX_POSITIONS=3           # max simultaneous open positions
MAX_DAILY_LOSS_PCT=0.03   # -3%  → auto-pause until next day
INITIAL_BALANCE=1000.0    # paper trading starting balance (USDT)

# ── Loop ──────────────────────────────────────────────────────────────────────
LOOP_INTERVAL=30          # seconds between each tick (30s for scalping)
