# Copy this file to .env — never commit your real .env
# Paper trading works without any API keys.

# ── Binance (live trading uniquement) ─────────────────────────────────────────
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
TRADING_MODE=paper          # "paper" | "live"

# ── Market ────────────────────────────────────────────────────────────────────
SYMBOL=BTC/USDT
TIMEFRAME=1m                # 1m | 3m | 5m | 15m | 1h

# ── Scalping indicators ───────────────────────────────────────────────────────
RSI_PERIOD=7
RSI_OVERSOLD=35
RSI_OVERBOUGHT=65
EMA_FAST=9
EMA_SLOW=21

# ── Risk management ───────────────────────────────────────────────────────────
STOP_LOSS_PCT=0.005         # -0.5%
TAKE_PROFIT_PCT=0.010       # +1.0%  (ratio 2:1)
CAPITAL_PER_TRADE=0.05      # 5% du portfolio par trade
MAX_POSITIONS=3             # positions simultanées max
MAX_DAILY_LOSS_PCT=0.03     # -3% → pause automatique jusqu'au lendemain
INITIAL_BALANCE=1000.0      # balance de départ paper trading (USDT)

# ── Telegram notifications ─────────────────────────────────────────────────────
# Laisser vide pour désactiver les notifications
# Voir README ou demander à Claude comment créer votre bot
TELEGRAM_TOKEN=             # ex: 7123456789:AAFxxx...
TELEGRAM_CHAT_ID=           # ex: 123456789

# ── Loop ──────────────────────────────────────────────────────────────────────
LOOP_INTERVAL=30            # secondes entre chaque tick (30s = scalping)
